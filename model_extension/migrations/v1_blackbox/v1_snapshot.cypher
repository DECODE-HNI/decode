CREATE CONSTRAINT Artifact_id_unique FOR (node:Artifact) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Assembly_id_unique FOR (node:Assembly) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Behavior_id_unique FOR (node:Behavior) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT CoreProperty_id_unique FOR (node:CoreProperty) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT DataItem_id_unique FOR (node:DataItem) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT DataQualityCriterion_id_unique FOR (node:DataQualityCriterion) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT DataQuality_id_unique FOR (node:DataQuality) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT DataSource_id_unique FOR (node:DataSource) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Feature_id_unique FOR (node:Feature) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Form_id_unique FOR (node:Form) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Function_id_unique FOR (node:Function) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Geometry_id_unique FOR (node:Geometry) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Material_id_unique FOR (node:Material) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Part_id_unique FOR (node:Part) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ProcessPlan_id_unique FOR (node:ProcessPlan) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Product_id_unique FOR (node:Product) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Requirement_id_unique FOR (node:Requirement) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Scenario_id_unique FOR (node:Scenario) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT SolutionPrinciple_id_unique FOR (node:SolutionPrinciple) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT Specification_id_unique FOR (node:Specification) REQUIRE (node.id) IS UNIQUE;
UNWIND [{id:"BEH_CLOSE", properties:{name:"Close jaws", state:"defined", behaviorType:"closing"}}, {id:"BEH_OPEN", properties:{name:"Open jaws", state:"defined", behaviorType:"opening"}}, {id:"BEH_CENTER", properties:{name:"Self-center object", state:"defined", behaviorType:"centering"}}, {id:"BEH_ADAPT", properties:{name:"Adapt fingers", state:"defined", behaviorType:"adaptive"}}, {id:"BEH_VACUUM", properties:{name:"Establish vacuum", state:"defined", behaviorType:"vacuum"}}, {id:"BEH_MAGNET", properties:{name:"Energize magnet", state:"defined", behaviorType:"magnetic"}}, {id:"BEH_RELEASE", properties:{name:"Release object", state:"defined", behaviorType:"release"}}] AS row
CREATE (n:Behavior{id: row.id}) SET n += row.properties;
UNWIND [{id:"ASSY_CUSTOM", properties:{name:"Custom Gripper assembly", variant:"official-custom", assemblyType:"End-effector assembly", status:"reference"}}, {id:"ASSY_LARGE", properties:{name:"Large Gripper assembly", variant:"official-large", assemblyType:"End-effector assembly", status:"reference"}}, {id:"ASSY_ADAPTIVE", properties:{name:"Adaptive Gripper assembly", variant:"official-adaptive", assemblyType:"End-effector assembly", status:"reference"}}, {id:"ASSY_VACUUM", properties:{name:"Vacuum Pump / Suction Tool assembly", variant:"official-vacuum", assemblyType:"End-effector assembly", status:"reference"}}, {id:"ASSY_MAGNET", properties:{name:"Electromagnet assembly", variant:"official-magnetic", assemblyType:"End-effector assembly", status:"reference"}}, {id:"ASSY_FLAT_PA12", properties:{name:"Custom + Flat jaws / PA12 / MJF assembly", variant:"custom-flat", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_PREC_PA12", properties:{name:"Custom + Precision jaws / PA12 / MJF assembly", variant:"custom-precision", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_XL_PA12", properties:{name:"Custom + XL jaws / PA12 / MJF assembly", variant:"custom-xl", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FLAT_PETG", properties:{name:"Flat jaws / PETG / FFF assembly", variant:"custom-flat", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FLAT_AL", properties:{name:"Flat jaws / Al6061 / CNC assembly", variant:"custom-flat", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_PREC_POM", properties:{name:"Precision jaws / POM / CNC assembly", variant:"custom-precision", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_PREC_AL7075", properties:{name:"Precision jaws / Al7075 / CNC assembly", variant:"custom-precision", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_XL_CFPA", properties:{name:"XL jaws / CF-PA / FFF assembly", variant:"custom-xl", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_V_PA12", properties:{name:"V-groove jaws / PA12 / MJF assembly", variant:"v-groove", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_V_PETG", properties:{name:"V-groove jaws / PETG / FFF assembly", variant:"v-groove", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_V_POM", properties:{name:"V-groove jaws / POM / CNC assembly", variant:"v-groove", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_V_AL", properties:{name:"V-groove jaws / Al6061 / CNC assembly", variant:"v-groove", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_CONC_PA12", properties:{name:"Concave jaws / PA12 / MJF assembly", variant:"concave", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_CONC_POM", properties:{name:"Concave jaws / POM / CNC assembly", variant:"concave", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_TPU_PAD", properties:{name:"PA12 jaws + TPU pads assembly", variant:"soft-pad", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_SIL_PAD", properties:{name:"Aluminum jaws + silicone pads assembly", variant:"soft-pad", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FINRAY_TPU", properties:{name:"Fin-Ray fingers / TPU / FFF assembly", variant:"finray", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FINRAY_TPE", properties:{name:"Fin-Ray fingers / TPE / FFF assembly", variant:"finray", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_LONG_CFPA", properties:{name:"Long-reach fingers / CF-PA / FFF assembly", variant:"long-reach", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_LONG_AL", properties:{name:"Long-reach fingers / Al6061 / CNC assembly", variant:"long-reach", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_THIN_POM", properties:{name:"Thin precision fingers / POM / CNC assembly", variant:"precision", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_THIN_STEEL", properties:{name:"Thin compliant fingers / spring steel assembly", variant:"precision-compliant", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_INTERNAL_PA12", properties:{name:"Internal-expansion fingers / PA12 / MJF assembly", variant:"internal", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_INTERNAL_AL", properties:{name:"Internal-expansion fingers / Al6061 / CNC assembly", variant:"internal", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_3FINGER_PA12", properties:{name:"Three-finger underactuated / PA12 assembly", variant:"three-finger", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_SOFT_SIL", properties:{name:"Soft pneumatic fingers / silicone assembly", variant:"soft-pneumatic", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_VAC_SMALL_NBR", properties:{name:"Small suction cup / NBR assembly", variant:"vacuum-small", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_VAC_LARGE_SIL", properties:{name:"Large suction cup / silicone assembly", variant:"vacuum-large", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_VAC_ARRAY", properties:{name:"Four-cup vacuum array assembly", variant:"vacuum-array", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_MAG_SMALL", properties:{name:"Small magnetic pole shoe assembly", variant:"magnetic-small", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_MAG_WIDE", properties:{name:"Wide magnetic pole shoe assembly", variant:"magnetic-wide", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_HYBRID", properties:{name:"Rigid-soft hybrid jaw / PA12+TPU assembly", variant:"hybrid", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FLAT_ABS", properties:{name:"Flat jaws / ABS / FFF assembly", variant:"custom-flat", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FLAT_ASA", properties:{name:"Flat jaws / ASA / FFF assembly", variant:"custom-flat", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_FLAT_PLA", properties:{name:"Flat jaws / PLA / FFF assembly", variant:"custom-flat", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_PREC_PA11", properties:{name:"Precision jaws / PA11 / SLS assembly", variant:"custom-precision", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_PREC_PC", properties:{name:"Precision jaws / PC / CNC assembly", variant:"custom-precision", assemblyType:"End-effector assembly", status:"candidate"}}, {id:"ASSY_PU_PAD", properties:{name:"PA12 jaws + PU pads assembly", variant:"soft-pad", assemblyType:"End-effector assembly", status:"candidate"}}] AS row
CREATE (n:Assembly{id: row.id}) SET n += row.properties;
UNWIND [{id:"FUNC_GRASP", properties:{output:"grasp state", input:"object / command", name:"Grasp object", functionType:"primary"}}, {id:"FUNC_RELEASE", properties:{output:"grasp state", input:"object / command", name:"Release object", functionType:"primary"}}, {id:"FUNC_RETAIN", properties:{output:"grasp state", input:"object / command", name:"Retain object", functionType:"primary"}}, {id:"FUNC_CENTER", properties:{output:"grasp state", input:"object / command", name:"Center object", functionType:"secondary"}}, {id:"FUNC_ADAPT", properties:{output:"grasp state", input:"object / command", name:"Adapt to object geometry", functionType:"secondary"}}, {id:"FUNC_PROTECT", properties:{output:"grasp state", input:"object / command", name:"Limit object damage", functionType:"secondary"}}, {id:"FUNC_TOOLCHANGE", properties:{output:"grasp state", input:"object / command", name:"Enable tool change", functionType:"support"}}, {id:"FUNC_CUSTOM_CONTACT", properties:{output:"grasp state", input:"object / command", name:"Adapt contact geometry", functionType:"support"}}] AS row
CREATE (n:Function{id: row.id}) SET n += row.properties;
UNWIND [{id:"REQ_COMPAT", properties:{name:"Ned2 compatibility", statement:"The gripper solution shall be mechanically and functionally compatible with the Niryo Ned2.", priority:"must", requirementType:"interface", status:"candidate"}}, {id:"REQ_EASYCONNECT", properties:{name:"EasyConnect interface", statement:"Preferred solutions shall use or adapt to the EasyConnect tool interface.", priority:"must", requirementType:"interface", status:"candidate"}}, {id:"REQ_PAYLOAD", properties:{name:"Payload constraint", statement:"Tool mass and object mass shall remain within the robot payload envelope.", priority:"must", requirementType:"performance", status:"candidate"}}, {id:"REQ_OPENING", properties:{name:"Opening width", statement:"Opening width shall match the target object geometry.", priority:"should", requirementType:"performance", status:"candidate"}}, {id:"REQ_CENTERING", properties:{name:"Object centering", statement:"The gripper should provide repeatable object centering.", priority:"should", requirementType:"function", status:"candidate"}}, {id:"REQ_FRAGILE", properties:{name:"Fragile-object handling", statement:"The contact concept should limit local pressure for fragile objects.", priority:"should", requirementType:"application", status:"candidate"}}, {id:"REQ_IRREGULAR", properties:{name:"Irregular-object handling", statement:"The solution should accommodate irregular geometries when required.", priority:"should", requirementType:"application", status:"candidate"}}, {id:"REQ_INTERNAL", properties:{name:"Internal gripping", statement:"A solution alternative should support internal gripping of hollow parts.", priority:"could", requirementType:"application", status:"candidate"}}, {id:"REQ_FLAT", properties:{name:"Flat non-porous gripping", statement:"Vacuum alternatives require flat, sufficiently non-porous surfaces.", priority:"should", requirementType:"application", status:"candidate"}}, {id:"REQ_FERRO", properties:{name:"Ferromagnetic gripping", statement:"Magnetic alternatives require sufficient ferromagnetic contact.", priority:"should", requirementType:"application", status:"candidate"}}, {id:"REQ_SMALL", properties:{name:"Small-part precision", statement:"The solution should allow accurate handling of small components.", priority:"should", requirementType:"application", status:"candidate"}}, {id:"REQ_LARGE", properties:{name:"Large-object opening", statement:"The solution should provide increased opening for bulky objects.", priority:"should", requirementType:"application", status:"candidate"}}, {id:"REQ_LONG", properties:{name:"Long reach", statement:"A solution should reach recessed objects when needed.", priority:"could", requirementType:"application", status:"candidate"}}, {id:"REQ_REPLACEABLE", properties:{name:"Replaceable jaws", statement:"Wear/contact parts should be independently replaceable.", priority:"should", requirementType:"maintainability", status:"candidate"}}, {id:"REQ_CUSTOM", properties:{name:"Customizable contact geometry", statement:"Contact geometry should be adaptable to workpiece geometry.", priority:"should", requirementType:"design", status:"candidate"}}, {id:"REQ_FRICTION", properties:{name:"Sufficient contact friction", statement:"Contact surfaces should provide sufficient friction without excessive damage.", priority:"should", requirementType:"function", status:"candidate"}}, {id:"REQ_LOW_MASS", properties:{name:"Low end-effector mass", statement:"End-effector mass should be minimized.", priority:"should", requirementType:"performance", status:"candidate"}}, {id:"REQ_DISASSEMBLY", properties:{name:"Design for disassembly", statement:"Wear parts, structure and actuator should be separable where feasible.", priority:"should", requirementType:"sustainability", status:"candidate"}}, {id:"REQ_REPAIR", properties:{name:"Repairability", statement:"High-wear components should be replaceable.", priority:"should", requirementType:"sustainability", status:"candidate"}}, {id:"REQ_MATERIAL_DIVERSITY", properties:{name:"Low material diversity", statement:"Avoid unnecessary material combinations.", priority:"could", requirementType:"sustainability", status:"candidate"}}, {id:"REQ_RECYCLABLE", properties:{name:"Recyclable structural material", statement:"Provide recyclable material alternatives where functional performance permits.", priority:"could", requirementType:"sustainability", status:"candidate"}}, {id:"REQ_LOCAL_AM", properties:{name:"Local additive manufacturing", statement:"Custom jaws should permit local/on-demand AM where suitable.", priority:"could", requirementType:"manufacturing", status:"candidate"}}, {id:"REQ_REV_JOIN", properties:{name:"Reversible joining", statement:"Prefer reversible fastening for replaceable contact parts.", priority:"should", requirementType:"sustainability", status:"candidate"}}, {id:"REQ_TRACE", properties:{name:"Data traceability", statement:"Assessment-relevant values shall retain source and quality metadata.", priority:"must", requirementType:"information", status:"candidate"}}] AS row
CREATE (n:Requirement{id: row.id}) SET n += row.properties;
UNWIND [{id:"CP_OPENING", properties:{unit:"mm", propertyType:"geometry/performance", name:"Opening width", status:"candidate"}}, {id:"CP_MASS", properties:{unit:"g", propertyType:"mass", name:"Tool mass", status:"candidate"}}, {id:"CP_TCP", properties:{unit:"mm", propertyType:"geometry", name:"TCP offset", status:"candidate"}}, {id:"CP_STIFFNESS", properties:{propertyType:"mechanical", name:"Finger stiffness", status:"candidate"}}, {id:"CP_COMPLIANCE", properties:{propertyType:"mechanical", name:"Contact compliance", status:"candidate"}}, {id:"CP_FRICTION", properties:{propertyType:"surface", name:"Contact friction", status:"candidate"}}, {id:"CP_GRIP_FORCE", properties:{propertyType:"performance", name:"Gripping / holding force", status:"candidate"}}, {id:"CP_PAYLOAD_MARGIN", properties:{unit:"g", propertyType:"performance", name:"Payload margin", status:"candidate"}}, {id:"CP_CONTACT_PRESSURE", properties:{propertyType:"performance", name:"Contact pressure", status:"candidate"}}, {id:"CP_DISASSEMBLY", properties:{propertyType:"sustainability", name:"Disassembly capability", status:"candidate"}}] AS row
CREATE (n:CoreProperty{id: row.id}) SET n += row.properties;
UNWIND [{id:"GEO_FLAT", properties:{length_mm:45.0, name:"Flat jaw geometry", width_mm:20.0, height_mm:8.0, geometryType:"jaw"}}, {id:"GEO_PRECISION", properties:{length_mm:60.0, name:"Precision jaw geometry", width_mm:8.0, height_mm:6.0, geometryType:"jaw"}}, {id:"GEO_XL", properties:{length_mm:85.0, name:"XL jaw geometry", width_mm:20.0, height_mm:10.0, geometryType:"jaw"}}, {id:"GEO_V", properties:{length_mm:50.0, openingAngle_deg:90.0, name:"V-groove jaw geometry", width_mm:22.0, height_mm:12.0, geometryType:"jaw"}}, {id:"GEO_CONCAVE", properties:{length_mm:50.0, name:"Concave jaw geometry", width_mm:24.0, height_mm:12.0, diameter_mm:30.0, geometryType:"jaw"}}, {id:"GEO_FINRAY", properties:{length_mm:70.0, name:"Fin-Ray finger envelope", width_mm:18.0, height_mm:16.0, geometryType:"finger"}}, {id:"GEO_LONG", properties:{length_mm:95.0, name:"Long finger geometry", width_mm:14.0, height_mm:10.0, geometryType:"finger"}}, {id:"GEO_INTERNAL", properties:{length_mm:55.0, name:"Internal finger geometry", width_mm:12.0, height_mm:10.0, diameter_mm:25.0, geometryType:"finger"}}, {id:"GEO_SOFT", properties:{length_mm:30.0, name:"Soft pad geometry", width_mm:20.0, height_mm:5.0, geometryType:"pad"}}, {id:"GEO_SUCTION_SMALL", properties:{name:"Small suction geometry", height_mm:18.0, diameter_mm:20.0, geometryType:"cup"}}, {id:"GEO_SUCTION_LARGE", properties:{name:"Large suction geometry", height_mm:25.0, diameter_mm:35.0, geometryType:"cup"}}, {id:"GEO_SUCTION_ARRAY", properties:{length_mm:60.0, name:"Four-cup array geometry", width_mm:60.0, height_mm:20.0, diameter_mm:20.0, geometryType:"array"}}, {id:"GEO_MAG_SMALL", properties:{length_mm:20.0, name:"Small magnetic pole", width_mm:20.0, height_mm:8.0, diameter_mm:20.0, geometryType:"pole"}}, {id:"GEO_MAG_WIDE", properties:{length_mm:45.0, name:"Wide magnetic pole", width_mm:20.0, height_mm:8.0, geometryType:"pole"}}] AS row
CREATE (n:Geometry{id: row.id}) SET n += row.properties;
