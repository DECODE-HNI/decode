	<uml:Profile xmi:id='_profile_RFLPV2Ext' name='RFLPV2_Sustainability_Process_Extension'>

		<!-- ============ local, self-contained datatypes/enums ============ -->
		<!-- Declared locally (not via external href) because Enterprise Architect's -->
		<!-- XMI import does not bind attribute Type references through nested       -->
		<!-- <type href='...'/> children reliably - confirmed empirically: the       -->
		<!-- attribute's Type field came back empty until switched to a local        -->
		<!-- classifier referenced via a plain type='...' XML attribute.             -->
		<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_type_Real' name='Real'/>
		<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_type_String' name='String'/>
		<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_type_Boolean' name='Boolean'/>
		<packagedElement xmi:type='uml:Enumeration' xmi:id='_enum_RealizationType' name='RealizationType'>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_RT_hardware' name='hardware'/>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_RT_software' name='software'/>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_RT_hybrid' name='hybrid'/>
		</packagedElement>
		<packagedElement xmi:type='uml:Enumeration' xmi:id='_enum_SustainabilityOperator' name='SustainabilityOperator'>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_SO_lessThan' name='lessThan'/>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_SO_lessOrEqual' name='lessOrEqual'/>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_SO_equal' name='equal'/>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_SO_greaterOrEqual' name='greaterOrEqual'/>
			<ownedLiteral xmi:type='uml:EnumerationLiteral' xmi:id='_lit_SO_greaterThan' name='greaterThan'/>
		</packagedElement>

