			<memberEnd xmi:idref='_ext_CustomerNeed_end'/>
			<ownedEnd xmi:type='uml:ExtensionEnd' xmi:id='_ext_CustomerNeed_end' name='extension_CustomerNeed' aggregation='composite' type='_st_CustomerNeed' association='_ext_CustomerNeed'/>
