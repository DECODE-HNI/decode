<?xml version='1.0' encoding='UTF-8'?>
<xmi:XMI xmlns:uml='http://www.omg.org/spec/UML/20131001' xmlns:xmi='http://www.omg.org/spec/XMI/20131001' xmlns:rflpv2ext='http://claude.local/profiles/RFLPV2SustainabilityProcessExtension'>
	<xmi:Documentation>
		<xmi:exporter>Claude</xmi:exporter>
		<xmi:exporterVersion>1.0</xmi:exporterVersion>
	</xmi:Documentation>

	<!-- ==================================================================== -->
	<!-- Representative example, end-to-end through the new profile extension: -->
	<!-- aluminium gripper jaw -> aluminium extrusion (process) -> GWP          -->
	<!-- sustainability requirement -> test case for the limit check.          -->
	<!-- ATTENTION: the IDs processRef='PROC_ALU_EXTRUSION_EF' and the         -->
	<!-- order of magnitude sustainabilityThreshold=120 stem from the last     -->
	<!-- known state at the time of writing, not from a fresh                  -->
	<!-- live query. materialRef='MAT_ALUMINIUM' and the part/requirement      -->
	<!-- IDs are plausible but NOT verified placeholders following the         -->
	<!-- naming convention - please match them against the real graph          -->
	<!-- (e.g. MATCH (p:Part) WHERE toLower(p.name) CONTAINS 'jaw' RETURN p.id).      -->
	<!--                                                                        -->
	<!-- This is a new, untested code path (instance import with               -->
	<!-- applied stereotypes), unlike the already validated                    -->
	<!-- profile import - one or two rounds of corrections may be needed again. -->
	<!-- ==================================================================== -->

	<uml:Model xmi:id='_model_RFLPV2Example' name='RFLPV2_Example_Model'>

		<packagedElement xmi:type='uml:Class' xmi:id='ex_part_jaw' name='Gripper jaw aluminium'/>
		<packagedElement xmi:type='uml:Class' xmi:id='ex_process_extrusion' name='Aluminium extrusion (EF)'/>
		<packagedElement xmi:type='uml:Class' xmi:id='ex_req_gwp' name='Climate impact of manufacturing'/>
		<packagedElement xmi:type='uml:OpaqueBehavior' xmi:id='ex_testcase_gwp' name='GWP limit check gripper jaw'/>

		<packagedElement xmi:type='uml:Dependency' xmi:id='ex_dep_realizes' client='ex_process_extrusion' supplier='ex_part_jaw'/>
		<packagedElement xmi:type='uml:Dependency' xmi:id='ex_dep_satisfies' client='ex_part_jaw' supplier='ex_req_gwp'/>
		<packagedElement xmi:type='uml:Dependency' xmi:id='ex_dep_verifies' client='ex_testcase_gwp' supplier='ex_req_gwp'/>

		<rflpv2ext:ProductElement xmi:id='ex_app_product' base_Class='ex_part_jaw'
			productID='PART_GRIPPER_JAW_AL'
			productType='Aluminium profile, machined'
			materialRef='MAT_ALUMINIUM'
			realizationType='hardware'/>

		<rflpv2ext:ProcessElement xmi:id='ex_app_process' base_Class='ex_process_extrusion'
			processID='PE_ALU_EXTRUSION'
			processType='Aluminium extrusion'
			lifecycleModule='A1-A3'
			processRef='PROC_ALU_EXTRUSION_EF'/>

		<rflpv2ext:SystemRequirement xmi:id='ex_app_requirement' base_Class='ex_req_gwp'
			sustainabilityIndicatorRef='IC_EF_GWP100'
			sustainabilityThreshold='120'
			sustainabilityOperator='lessOrEqual'
			sustainabilityUnit='kgCO2eq'
			sustainabilityScope='A1-A3'/>

		<rflpv2ext:TestCase xmi:id='ex_app_testcase' base_Behavior='ex_testcase_gwp'
			testCaseOwner='V&amp;V-Team'
			systemLevel='Component'
			testMethod='Analysis'
			dataAnalysisType='LCA calculation'
			sustainabilityStatus='notEvaluated'/>

		<rflpv2ext:Realizes xmi:id='ex_app_realizes' base_Dependency='ex_dep_realizes'/>
		<rflpv2ext:Satisfies xmi:id='ex_app_satisfies' base_Dependency='ex_dep_satisfies'/>
		<rflpv2ext:Verifies xmi:id='ex_app_verifies' base_Dependency='ex_dep_verifies'/>

	</uml:Model>
</xmi:XMI>
