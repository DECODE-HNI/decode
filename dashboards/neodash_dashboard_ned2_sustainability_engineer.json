                                          "type":  "text",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "ne1-assessments-total",
                                          "title":  "Varianten-Screenings gesamt",
                                          "query":  "MATCH (a:Assessment) WHERE a.assessmentType IS NOT NULL RETURN count(a) AS Screening_Assessments_gesamt",
                                          "width":  6,
                                          "height":  3,
                                          "x":  0,
                                          "y":  3,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Screening_Assessments_gesamt"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "ne1-assessments-real",
                                          "title":  "Davon mit berechneten Werten",
                                          "query":  "MATCH (a:Assessment) WHERE a.assessmentType IS NOT NULL OPTIONAL MATCH (a)-[:HAS_RESULT]-\u003e(r:ImpactResult) WHERE r.value IS NOT NULL WITH a, count(r) AS n RETURN sum(CASE WHEN n\u003e0 THEN 1 ELSE 0 END) AS Mit_berechneten_Werten",
                                          "width":  6,
                                          "height":  3,
                                          "x":  6,
                                          "y":  3,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Mit_berechneten_Werten"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "ne1-assessment-list",
                                          "title":  "Alle Assessments nach Datenstatus (inkl. AAS-Import-Demo)",
                                          "query":  "MATCH (a:Assessment) OPTIONAL MATCH (a)-[:HAS_RESULT]-\u003e(r:ImpactResult) WHERE r.value IS NOT NULL WITH a, count(r) AS n RETURN COALESCE(a.name, a.id) AS Bewertung, COALESCE(a.developmentPhase, a.lifeCycleStage) AS Phase, COALESCE(a.methodology, \u0027AAS-Import\u0027) AS Methodik, CASE WHEN n \u003e 0 THEN \u0027berechnet\u0027 WHEN a.assessmentType IS NULL THEN \u0027berechnet (AAS-Import)\u0027 ELSE \u0027ausstehend\u0027 END AS Datenstatus ORDER BY Datenstatus, Bewertung",
                                          "width":  12,
                                          "height":  7,
                                          "x":  0,
                                          "y":  6,
                                          "type":  "table",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      }
                                  ]
                  },
