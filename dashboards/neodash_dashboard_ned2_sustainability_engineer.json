                                                       }
                                      },
                                      {
                                          "id":  "ne1-assessment-list",
                                          "title":  "All assessments by data status (incl. AAS import demo)",
                                          "query":  "MATCH (a:Assessment) OPTIONAL MATCH (a)-[:HAS_RESULT]-\u003e(r:ImpactResult) WHERE r.value IS NOT NULL WITH a, count(r) AS n RETURN COALESCE(a.name, a.id) AS Assessment, COALESCE(a.developmentPhase, a.lifeCycleStage) AS Phase, COALESCE(a.methodology, \u0027AAS import\u0027) AS Methodology, CASE WHEN n \u003e 0 THEN \u0027computed\u0027 WHEN a.assessmentType IS NULL THEN \u0027computed (AAS import)\u0027 ELSE \u0027pending\u0027 END AS Data_status ORDER BY Data_status, Assessment",
