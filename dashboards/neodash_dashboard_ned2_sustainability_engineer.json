                                          "title":  "Of which with computed values",
                                          "query":  "MATCH (a:Assessment) WHERE a.assessmentType IS NOT NULL OPTIONAL MATCH (a)-[:HAS_RESULT]-\u003e(r:ImpactResult) WHERE r.value IS NOT NULL WITH a, count(r) AS n RETURN sum(CASE WHEN n\u003e0 THEN 1 ELSE 0 END) AS With_computed_values",
