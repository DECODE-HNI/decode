                                          "title":  "Repair benefit ratio (1 − repair/new production)",
                                          "query":  "MATCH (m:ImpactResult {id:\u0027RES_PREC_AL7075_CC\u0027}), (rep:ImpactResult {id:\u0027RES_PREC_AL7075_REPAIR_CC\u0027}) RETURN round(10000.0*(1 - rep.value/m.value))/100 AS Repair_benefit_ratio_percent",
