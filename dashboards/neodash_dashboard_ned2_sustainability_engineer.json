                                          "title":  "Zweck dieser Seite",
                                          "query":  "## PREC_AL7075 - das einzige durchgerechnete Beispiel\n\nNeufertigung vs. Reparatur, die zehn EN15804/EF3.1-Indikatoren aus der Black-Box-AAS und die zugrunde liegenden Stoff-/Energieströme - alles real berechnet, nichts geschätzt.",
                                          "width":  12,
                                          "height":  3,
                                          "x":  0,
                                          "y":  0,
                                          "type":  "text",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "ne2-manuf-vs-repair",
                                          "title":  "Neufertigung vs. Reparatur (kg CO2-eq)",
                                          "query":  "MATCH (r:ImpactResult) WHERE r.id IN [\u0027RES_PREC_AL7075_CC\u0027,\u0027RES_PREC_AL7075_REPAIR_CC\u0027] RETURN CASE r.id WHEN \u0027RES_PREC_AL7075_CC\u0027 THEN \u0027Neufertigung (A1-A3)\u0027 ELSE \u0027Reparatur (B4)\u0027 END AS Phase, r.value AS kgCO2eq ORDER BY kgCO2eq DESC",
                                          "width":  8,
                                          "height":  4,
                                          "x":  0,
                                          "y":  3,
                                          "type":  "table",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
