                  {
                      "title":  "Repairability \u0026 requirements",
                      "reports":  [
                                      {
                                          "id":  "se2-intro",
                                          "title":  "Purpose of this page",
                                          "query":  "## Repairability \u0026 requirements verification\n\nThere is as yet no quantified repairability score in the graph. This page shows the structural signals that actually exist: joining technique, service process coverage and requirements traceability.",
                                          "width":  12,
                                          "height":  3,
                                          "x":  0,
                                          "y":  0,
                                          "type":  "text",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se2-screw-pct",
                                          "title":  "Share of variants with reversible joining (screw instead of gluing/welding)",
                                          "query":  "MATCH (pp:ProcessPlan) WITH count(pp) AS total MATCH (s:ProcessPlan)-[:CONTAINS_PROCESS]-\u003e(:Process {id:\u0027PROC_SCREW\u0027}) WITH total, count(DISTINCT s) AS with_screw RETURN round(100.0*with_screw/total) AS Percent_reversibly_joined",
                                          "width":  6,
                                          "height":  3,
                                          "x":  0,
                                          "y":  3,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Percent_reversibly_joined"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se2-repair-pct",
                                          "title":  "Share of variants with a modelled service/repair process",
                                          "query":  "MATCH (pp:ProcessPlan) WITH count(pp) AS total MATCH (s:ProcessPlan)-[:CONTAINS_PROCESS]-\u003e(:Process {id:\u0027PROC_REPAIR\u0027}) WITH total, count(DISTINCT s) AS with_repair RETURN round(100.0*with_repair/total) AS Percent_with_service_process",
                                          "width":  6,
                                          "height":  3,
                                          "x":  6,
                                          "y":  3,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Percent_with_service_process"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se2-req-coverage",
                                          "title":  "Requirements traceability: repairability \u0026 circularity",
                                          "query":  "MATCH (r:Requirement) WHERE r.id IN [\u0027REQ_REPLACEABLE\u0027,\u0027REQ_MATERIAL_DIVERSITY\u0027,\u0027REQ_RECYCLABLE\u0027,\u0027REQ_REPAIR\u0027,\u0027REQ_REV_JOIN\u0027,\u0027REQ_DISASSEMBLY\u0027] OPTIONAL MATCH (x)-[s:SATISFIES_REQUIREMENT]-\u003e(r) RETURN r.name AS Requirement, r.statement AS Description, count(x) AS Variants_with_evidence, collect(DISTINCT s.verificationStatus) AS Verification_status ORDER BY Variants_with_evidence DESC",
                                          "width":  12,
                                          "height":  6,
                                          "x":  0,
                                          "y":  6,
                                          "type":  "table",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      }
                                  ]
                  },
                  {
                      "title":  "Design-for-repair signals (iFixit-inspired)",
                      "reports":  [
                                      {
                                          "id":  "se3-intro",
                                          "title":  "Purpose of this page",
                                          "query":  "## Design-for-repair signals, inspired by iFixit\u0027s teardown criteria\n\niFixit does not publish a single official formula but a teardown rubric that has grown over the years (among others joining technique, modularity, spare-part availability, documentation, tools required). Four of these can be derived honestly from the graph today: reversible joining, documented replaceability, printable spare parts, material simplicity. Number of tools/steps and a dedicated repair manual are still completely missing as data — deliberately no tile for them, so as not to estimate anything.",
                                          "width":  12,
                                          "height":  4,
                                          "x":  0,
                                          "y":  0,
                                          "type":  "text",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se3-signal-distribution",
                                          "title":  "How many of the 4 signals does each variant meet?",
                                          "query":  "MATCH (art:Artifact) OPTIONAL MATCH (art)-[:HAS_PROCESS_PLAN]-\u003e(pp:ProcessPlan)-[:CONTAINS_PROCESS]-\u003e(:Process {id:\u0027PROC_SCREW\u0027}) WITH art, count(pp) \u003e 0 AS ReversibleJoint OPTIONAL MATCH (art)-[:SATISFIES_REQUIREMENT]-\u003e(r:Requirement) WHERE r.id IN [\u0027REQ_REPLACEABLE\u0027,\u0027REQ_REPAIR\u0027] WITH art, ReversibleJoint, count(DISTINCT r) \u003e 0 AS ReplacementDocumented OPTIONAL MATCH (art)-[:HAS_FEATURE]-\u003e(feat:Feature {id:\u0027FEAT_PRINTABLE\u0027}) WITH art, ReversibleJoint, ReplacementDocumented, count(feat) \u003e 0 AS PrintableSpare OPTIONAL MATCH (art)-[:HAS_COMPONENT]-\u003e(:Assembly)-[:HAS_COMPONENT]-\u003e(part:Part)-[:USES_MATERIAL]-\u003e(m:Material) WITH art, ReversibleJoint, ReplacementDocumented, PrintableSpare, count(DISTINCT m.materialType) AS MaterialTypes RETURN (CASE WHEN ReversibleJoint THEN 1 ELSE 0 END + CASE WHEN ReplacementDocumented THEN 1 ELSE 0 END + CASE WHEN PrintableSpare THEN 1 ELSE 0 END + CASE WHEN MaterialTypes \u003c= 1 THEN 1 ELSE 0 END) AS Signals_met, count(art) AS Variant_count ORDER BY Signals_met DESC",
                                          "width":  6,
                                          "height":  4,
                                          "x":  0,
                                          "y":  4,
                                          "type":  "table",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se3-material-diversity",
                                          "title":  "Material diversity per assembly (contact + interface part)",
                                          "query":  "MATCH (a:Assembly)-[:HAS_COMPONENT]-\u003e(part:Part)-[:USES_MATERIAL]-\u003e(m:Material) WITH a, collect(DISTINCT m.materialType) AS MaterialTypes RETURN size(MaterialTypes) AS Material_type_count, count(*) AS Assembly_count ORDER BY Material_type_count",
                                          "width":  3,
                                          "height":  4,
                                          "x":  6,
                                          "y":  4,
                                          "type":  "table",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se3-printable-count",
                                          "title":  "Variants with printable replacement jaws",
                                          "query":  "MATCH (art:Artifact)-[:HAS_FEATURE]-\u003e(:Feature {id:\u0027FEAT_PRINTABLE\u0027}) RETURN count(art) AS Variants_with_printable_spares",
                                          "width":  3,
                                          "height":  4,
                                          "x":  9,
                                          "y":  4,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Variants_with_printable_spares"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se3-scorecard",
                                          "title":  "iFixit-inspired scorecard per variant (all 43)",
                                          "query":  "MATCH (art:Artifact) OPTIONAL MATCH (art)-[:HAS_PROCESS_PLAN]-\u003e(pp:ProcessPlan)-[:CONTAINS_PROCESS]-\u003e(:Process {id:\u0027PROC_SCREW\u0027}) WITH art, count(pp) \u003e 0 AS ReversibleJoint OPTIONAL MATCH (art)-[:SATISFIES_REQUIREMENT]-\u003e(r:Requirement) WHERE r.id IN [\u0027REQ_REPLACEABLE\u0027,\u0027REQ_REPAIR\u0027] WITH art, ReversibleJoint, count(DISTINCT r) \u003e 0 AS ReplacementDocumented OPTIONAL MATCH (art)-[:HAS_FEATURE]-\u003e(feat:Feature {id:\u0027FEAT_PRINTABLE\u0027}) WITH art, ReversibleJoint, ReplacementDocumented, count(feat) \u003e 0 AS PrintableSpare OPTIONAL MATCH (art)-[:HAS_COMPONENT]-\u003e(:Assembly)-[:HAS_COMPONENT]-\u003e(part:Part)-[:USES_MATERIAL]-\u003e(m:Material) WITH art, ReversibleJoint, ReplacementDocumented, PrintableSpare, count(DISTINCT m.materialType) AS MaterialTypes RETURN art.name AS Variant, ReversibleJoint, ReplacementDocumented, PrintableSpare, MaterialTypes, (CASE WHEN ReversibleJoint THEN 1 ELSE 0 END + CASE WHEN ReplacementDocumented THEN 1 ELSE 0 END + CASE WHEN PrintableSpare THEN 1 ELSE 0 END + CASE WHEN MaterialTypes \u003c= 1 THEN 1 ELSE 0 END) AS Signals_met ORDER BY Signals_met DESC, Variant",
                                          "width":  12,
                                          "height":  8,
                                          "x":  0,
                                          "y":  8,
                                          "type":  "table",
                                          "selection":  {

