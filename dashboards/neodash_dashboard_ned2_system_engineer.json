                  {
                      "title":  "Reparierbarkeit \u0026 Anforderungen",
                      "reports":  [
                                      {
                                          "id":  "se2-intro",
                                          "title":  "Zweck dieser Seite",
                                          "query":  "## Reparierbarkeit \u0026 Anforderungs-Nachweis\n\nEs existiert noch kein quantifizierter Reparierbarkeits-Score im Graphen. Diese Seite zeigt die tatsächlich vorhandenen strukturellen Signale: Fügetechnik, Service-Prozessabdeckung und Requirements-Traceability.",
                                          "width":  12,
                                          "height":  3,
                                          "x":  0,
                                          "y":  0,
                                          "type":  "text",
                                          "selection":  {

                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se2-screw-pct",
                                          "title":  "Variantenanteil mit reversibler Fügung (Schraube statt Kleben/Schweißen)",
                                          "query":  "MATCH (pp:ProcessPlan) WITH count(pp) AS total MATCH (s:ProcessPlan)-[:CONTAINS_PROCESS]-\u003e(:Process {id:\u0027PROC_SCREW\u0027}) WITH total, count(DISTINCT s) AS mit RETURN round(100.0*mit/total) AS Prozent_reversibel_gefügt",
                                          "width":  6,
                                          "height":  3,
                                          "x":  0,
                                          "y":  3,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Prozent_reversibel_gefügt"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se2-repair-pct",
                                          "title":  "Variantenanteil mit modelliertem Service-/Reparaturprozess",
                                          "query":  "MATCH (pp:ProcessPlan) WITH count(pp) AS total MATCH (s:ProcessPlan)-[:CONTAINS_PROCESS]-\u003e(:Process {id:\u0027PROC_REPAIR\u0027}) WITH total, count(DISTINCT s) AS mit RETURN round(100.0*mit/total) AS Prozent_mit_Serviceprozess",
                                          "width":  6,
                                          "height":  3,
                                          "x":  6,
                                          "y":  3,
                                          "type":  "value",
                                          "selection":  {
                                                            "value":  "Prozent_mit_Serviceprozess"
                                                        },
                                          "settings":  {

                                                       }
                                      },
                                      {
                                          "id":  "se2-req-coverage",
                                          "title":  "Requirements-Traceability: Reparierbarkeit \u0026 Kreislauffähigkeit",
                                          "query":  "MATCH (r:Requirement) WHERE r.id IN [\u0027REQ_REPLACEABLE\u0027,\u0027REQ_MATERIAL_DIVERSITY\u0027,\u0027REQ_RECYCLABLE\u0027,\u0027REQ_REPAIR\u0027,\u0027REQ_REV_JOIN\u0027,\u0027REQ_DISASSEMBLY\u0027] OPTIONAL MATCH (x)-[s:SATISFIES_REQUIREMENT]-\u003e(r) RETURN r.name AS Anforderung, r.statement AS Beschreibung, count(x) AS Varianten_mit_Nachweis, collect(DISTINCT s.verificationStatus) AS Nachweisstatus ORDER BY Varianten_mit_Nachweis DESC",
                                          "width":  12,
                                          "height":  6,
                                          "x":  0,
                                          "y":  6,
                                          "type":  "table",
